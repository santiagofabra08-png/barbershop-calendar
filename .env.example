# Copiá este archivo a .env.local y completá los valores.
# .env.local nunca se commitea.

# --- Supabase ---
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO servidor. Nunca prefijar con NEXT_PUBLIC_ ni importar desde un componente cliente.
# Saltea Row Level Security: se usa únicamente en rutas/acciones de servidor.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Dominio raíz desde el que se resuelve el tenant: {slug}.tuapp.com
NEXT_PUBLIC_ROOT_DOMAIN=tuapp.com
# URL base para links absolutos (mails de confirmación, cancelación)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Mail de confirmación (Resend) ---
# Sin estas dos variables el proyecto anda igual: la reserva se guarda y el
# cliente ve su turno en pantalla, solo que no le llega el mail.
# resend.com/api-keys
RESEND_API_KEY=
# Remitente. Sin dominio propio verificado, Resend solo deja usar
# onboarding@resend.dev, y solo envía al mail de tu cuenta.
RESEND_FROM=Tropi Barbershop <onboarding@resend.dev>

# --- Solo desarrollo ---
# La barbería se resuelve del subdominio, y localhost no tiene.
# Con esto, http://localhost:3000 abre esta barbería.
# Alternativa sin esta variable: poner NEXT_PUBLIC_ROOT_DOMAIN=lvh.me y entrar
# a http://tropi-barbershop.lvh.me:3000 — lvh.me apunta siempre a tu máquina.
# En producción se ignora: sin subdominio no hay barbería.
DEV_TENANT_SLUG=tropi-barbershop
