# Copiá este archivo a .env.local y completá los valores.
# .env.local nunca se commitea.

# --- Supabase ---
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO servidor. Nunca prefijar con NEXT_PUBLIC_ ni importar desde un componente cliente.
# Saltea Row Level Security: se usa únicamente en rutas/acciones de servidor.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Dominio raíz desde el que se resuelve el tenant: {slug}.tuapp.com
NEXT_PUBLIC_ROOT_DOMAIN=tuapp.com
# URL base para links absolutos (mails de confirmación, cancelación)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Cómo se pide el producto (solo la portada del dominio pelado) ---
# El botón de la portada. Si hay número de WhatsApp se usa ese, porque un dueño
# de barbería escribe por WhatsApp y no manda un mail; el mail queda de
# alternativa. Si no hay ninguno de los dos, no se dibuja el botón: una llamada
# a la acción que no lleva a ningún lado es peor que ninguna.
# Con código de país y sin signos: 59899123456
NEXT_PUBLIC_CONTACT_WHATSAPP=
# Si se deja vacío, la portada no ofrece ninguna dirección. A propósito: no se
# deduce del dominio, porque una dirección que suena razonable y no existe hace
# que alguien escriba, crea que avisó, y su mensaje se pierda. Poner acá una
# casilla que alguien lea de verdad, o dejarla vacía.
NEXT_PUBLIC_CONTACT_EMAIL=

# El precio del plan mensual, en la portada. Un entero, sin símbolos ni puntos.
# Vive acá y no en el código para que cambiar un precio no sea un despliegue.
# Vacío: la sección invita a preguntarlo en vez de inventar un número.
NEXT_PUBLIC_PRECIO_MENSUAL=
# Código de moneda ISO: UYU, ARS, USD. Por defecto UYU.
NEXT_PUBLIC_PRECIO_MONEDA=

# El mismo precio en la moneda de acá, para que un barbero no tenga que sacar
# la cuenta. Se muestra chiquito, debajo del precio principal.
#
# Se escribe a mano y NO se convierte con una cotización, a propósito: una
# cotización queda vieja sola, y el día que se mueve la página muestra un precio
# que no es el que vas a cobrar. Nadie se entera hasta que un cliente lo
# reclama. Escribiendo los dos números, el que decide cuánto sale sos vos.
#
# Vacío: no se muestra nada. El precio principal alcanza.
NEXT_PUBLIC_PRECIO_MENSUAL_ALT=
NEXT_PUBLIC_PRECIO_MONEDA_ALT=

# A qué casilla llega el aviso cuando alguien deja sus datos en la portada.
# SIN prefijo NEXT_PUBLIC_ a propósito: es tu mail, no tiene por qué viajar al
# navegador de todo el que abre la página. Sin esto, la solicitud igual se
# guarda en la base —nunca se pierde a nadie—, pero no te enterás hasta que la
# mires a mano.
SOLICITUDES_MAIL=

# --- La barbería de demostración de la portada ---
# La portada muestra `demo.<dominio>` incrustada y funcionando, así que la gente
# reserva de verdad ahí adentro. Vercel llama a /api/limpiar-demo una vez por
# día para vaciarla; sin horarios libres, la demo no demuestra nada.
#
# Este secreto es lo único que separa esa ruta de cualquiera que la descubra.
# Vercel lo manda solo, como `Authorization: Bearer`, cuando la variable existe.
# Un valor largo y al azar: openssl rand -base64 32
CRON_SECRET=

# --- Mail de confirmación (Resend) ---
# Sin estas dos variables el proyecto anda igual: la reserva se guarda y el
# cliente ve su turno en pantalla, solo que no le llega el mail.
# resend.com/api-keys
RESEND_API_KEY=
# Remitente. Sin dominio propio verificado, Resend solo deja usar
# onboarding@resend.dev, y solo envía al mail de tu cuenta.
#
# De acá se usa SOLO LA DIRECCIÓN, que es la que tiene que pertenecer al
# dominio verificado. El nombre que se ve en la bandeja de entrada lo pone
# cada barbería: un turno en Barbería Central llega firmado "Barbería
# Central", no con lo que diga esta línea.
#
# El nombre de acá queda para el único mail que no es de ninguna barbería: el
# aviso de que alguien pidió probar el producto desde la portada. Por eso
# conviene que diga el nombre del producto y no el de un local.
RESEND_FROM=Turnos for Barber <onboarding@resend.dev>

# --- Solo desarrollo ---
# La barbería se resuelve del subdominio, y localhost no tiene.
# Con esto, http://localhost:3000 abre esta barbería.
# Alternativa sin esta variable: poner NEXT_PUBLIC_ROOT_DOMAIN=lvh.me y entrar
# a http://tropi-barbershop.lvh.me:3000 — lvh.me apunta siempre a tu máquina.
# En producción se ignora: sin subdominio no hay barbería.
DEV_TENANT_SLUG=tropi-barbershop

# Para abrir la página desde el celular con la IP de la computadora.
# Por defecto se permiten los rangos de red doméstica; solo hace falta tocar
# esto si tu red usa otro rango. Separar con comas. Solo aplica a `next dev`.
# DEV_ALLOWED_ORIGINS=192.168.*.*,10.*.*.*
